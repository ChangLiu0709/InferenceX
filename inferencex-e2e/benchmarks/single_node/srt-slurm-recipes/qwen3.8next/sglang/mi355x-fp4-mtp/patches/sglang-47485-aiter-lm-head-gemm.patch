sgl-project/sglang#47485 (open), head e1f8ae20a7: [Perf] [AMD] lm_head: Opt-in aiter tgemm for the bf16 lm_head on gfx950
the PR's single commit; applies to the image's SGLang 17e94c4677
diff --git a/python/sglang/srt/environ.py b/python/sglang/srt/environ.py
index 03efaa6801..53f0348649 100644
--- a/python/sglang/srt/environ.py
+++ b/python/sglang/srt/environ.py
@@ -1070,6 +1070,9 @@ class Envs:
     # ROCPROFILER_REGISTER_LIBRARY.
     SGLANG_ROCM_KEEP_INHERITED_ROCPROFILER_REGISTER = EnvBool(False)
     SGLANG_ROCM_DISABLE_LINEARQUANT = EnvBool(False)
+    # Run the BF16 lm_head through aiter tgemm, as gfx1250 always does,
+    # so its tuned rows apply instead of hipBLASLt's heuristic (measured on gfx950).
+    SGLANG_OPT_AITER_LM_HEAD_GEMM = EnvBool(False)
     USE_ROCM_AITER_ROPE_BACKEND = EnvStr("0")
     # Enable dual-stream MoE (shared experts vs routed experts) on the
     # ROCm/AITER path. Requires GPU_MAX_HW_QUEUES>=5 to avoid HW-queue serialization.
diff --git a/python/sglang/srt/layers/logits_processor.py b/python/sglang/srt/layers/logits_processor.py
index ede078b6c7..ab0bde81db 100644
--- a/python/sglang/srt/layers/logits_processor.py
+++ b/python/sglang/srt/layers/logits_processor.py
@@ -83,7 +83,11 @@ logger = logging.getLogger(__name__)
 _is_npu = is_npu()
 _is_cpu = is_cpu()
 # On gfx1250, torch.mm for a bf16 lm_head is slower than aiter's GEMM.
-_use_aiter_lm_head = is_hip() and envs.SGLANG_USE_AITER.get() and is_gfx1250_supported()
+_use_aiter_lm_head = (
+    is_hip()
+    and envs.SGLANG_USE_AITER.get()
+    and (is_gfx1250_supported() or envs.SGLANG_OPT_AITER_LM_HEAD_GEMM.get())
+)
 if _use_aiter_lm_head:
     from aiter.tuned_gemm import tgemm
 
