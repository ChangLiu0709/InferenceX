--- /dev/null
+++ b/sgl_amd_mono/qwen38_flash_next/check.py
@@ -0,0 +1,249 @@
+# SPDX-License-Identifier: Apache-2.0
+"""SGLANG_AMD_MONO_CHECK=1: at build, the weights the launches read of three layers
+against the checkpoint's bytes (``weights``); then (eager steps only) every routed
+verify step also runs SGLang's own forward of the step first, on the caches as they
+were, and the launches' outputs are checked against it: the logits and the hidden
+states (the residual streams after the last layer, which the MTP draft reads), each
+against its ``spec.NUMERICS`` bound, on the worst row. Every check is logged; a miss
+is logged as a violation.
+
+The 13 launches run the whole model, so the check covers the step, not a layer.
+Both forwards write the same cache rows (the draft tokens' KV, index keys and
+verify scratch) from the same committed state, and the launches write them last,
+so the step leaves the caches as an unchecked step would."""
+
+from __future__ import annotations
+
+import logging
+
+import torch
+import torch.nn.functional as F
+
+logger = logging.getLogger(__name__)
+
+# The SGLang names this module reads, by file under the sglang package (``f(p)``: a
+# parameter, ``"x"``: a string literal); test/unit/test_contract.py pins them.
+SGLANG_READS = {
+    "srt/runtime_context.py": ("get_server_args",),
+    "srt/arg_groups/fields/*.py": ("model_path", "revision"),
+    "srt/layers/logits_processor.py": ("next_token_logits", "hidden_states"),
+    "srt/model_executor/forward_batch_info.py": (
+        "positions",
+        "batch_size",
+        "req_pool_indices",
+    ),
+    "srt/model_executor/forward_context.py": ("get_req_to_token_pool",),
+    "srt/mem_cache/memory_pool.py": (
+        "get_mamba_indices",
+        "mamba2_layer_cache",
+        "conv",
+        "temporal",
+        "short_conv_layer_cache",
+    ),
+}
+
+
+def _committed_state(kinds: list[str], forward_batch) -> list[tuple]:
+    """The committed recurrent state the launches read: SGLang's verify conv update
+    rolls the draft tokens into the GDN (and PLE short-conv) state in place."""
+    from sglang.srt.model_executor.forward_context import get_req_to_token_pool
+
+    rtp = get_req_to_token_pool()
+    slots = rtp.get_mamba_indices(forward_batch.req_pool_indices).long()
+    saved = []
+    for layer_id, kind in enumerate(kinds):
+        if kind != "gdn":
+            continue
+        cache = rtp.mamba2_layer_cache(layer_id)
+        for t in (cache.conv[0], cache.temporal):
+            saved.append((t, slots, t[slots].clone()))
+    ple = rtp.short_conv_layer_cache(1)
+    saved.append((ple, None, ple.clone()))
+    return saved
+
+
+def reference(lm, input_ids, positions, forward_batch, kinds: list[str]) -> dict:
+    """SGLang's forward of the step: its logits and hidden states. The committed
+    state it advances is restored, so the launches read the state as it was."""
+    saved = _committed_state(kinds, forward_batch)
+    out = type(lm).forward(lm, input_ids, positions, forward_batch)
+    for t, idx, v in saved:
+        if idx is None:
+            t.copy_(v)
+        else:
+            t[idx] = v
+    return {
+        "logits": out.next_token_logits.clone(),
+        "hidden": out.hidden_states.clone(),
+    }
+
+
+def _metrics(a: torch.Tensor, b: torch.Tensor) -> dict[str, float]:
+    """The worst row's cosine and relative difference."""
+    a, b = a.float().flatten(1), b.float().flatten(1)
+    rel = (a - b).norm(dim=1) / b.norm(dim=1).clamp_min(1e-30)
+    return {
+        "cosine": F.cosine_similarity(a, b, dim=1).min().item(),
+        "rel": rel.max().item(),
+        "max_abs": (a - b).abs().max().item(),
+    }
+
+
+def compare(ref: dict, out, forward_batch) -> None:
+    from sgl_amd_mono.qwen38_flash_next.spec import NUMERICS
+
+    got = {"logits": out.next_token_logits, "hidden": out.hidden_states}
+    values = {
+        f"verify.{name}.{metric}": v
+        for name in ("logits", "hidden")
+        for metric, v in _metrics(got[name], ref[name]).items()
+    }
+    pos = forward_batch.positions
+    pos = pos[0] if pos.dim() == 2 else pos
+    logger.info(
+        "monokernel check step (%d requests, positions %d..%d): %s",
+        int(forward_batch.batch_size),
+        pos.min().item(),
+        pos.max().item(),
+        " ".join(f"{k}={v:.6g}" for k, v in values.items()),
+    )
+    for name, bound in NUMERICS.bounds.items():
+        v = values.get(name)
+        if v is None:
+            continue
+        ok = v >= bound if name.endswith(".cosine") else v <= bound
+        if not ok:
+            logger.error("monokernel check violation: %s = %.6g, bound %g", name, v, bound)  # fmt: skip
+
+
+# ---------------------------------------------------------------- weights
+# the checkpoint's names: the text model's prefix, and the tensors each FP8
+# projection the kernel reads merges (kernel name -> checkpoint names in the layer)
+PREFIX = "model.language_model."
+CHECKED_LAYERS = {0: "gdn", 1: "gdn", 3: "qsa"}  # a GDN, the PLE and a QSA layer
+SHARED_EXPERT = 512  # fused after the 512 routed experts
+CHECKED_EXPERTS = (0, 255, 511, SHARED_EXPERT)
+# keyed by layer kind: both kinds name their output projection "out"
+PROJ_SOURCES = {
+    "gdn": {
+        "ip": ("linear_attn.in_proj_qkv", "linear_attn.in_proj_z"),
+        "out": ("linear_attn.out_proj",),
+        "ba": ("linear_attn.in_proj_b", "linear_attn.in_proj_a"),
+    },
+    "qsa": {
+        "qp": ("self_attn.q_proj", "self_attn.k_proj", "self_attn.v_proj"),
+        "qp2": ("self_attn.indexer.index_qk_proj",),
+        "out": ("self_attn.o_proj",),
+    },
+}
+
+
+def _checkpoint_dir() -> str:
+    """The served checkpoint's directory: only its safetensors are read, so a
+    partial HF cache resolves."""
+    import os
+
+    from sglang.srt.runtime_context import get_server_args
+
+    args = get_server_args()
+    path = args.model_path
+    if not os.path.isdir(path):
+        from huggingface_hub import snapshot_download
+
+        path = snapshot_download(
+            path,
+            revision=args.revision,
+            local_files_only=True,
+            allow_patterns=["*.safetensors", "*.safetensors.index.json"],
+        )
+    return path
+
+
+def _expert_name(e: int) -> str:
+    return "mlp.shared_expert" if e == SHARED_EXPERT else f"mlp.experts.{e}"
+
+
+def _load(path: str, names: list[str], device) -> dict:
+    import json
+    import os
+
+    from safetensors import safe_open
+
+    with open(os.path.join(path, "model.safetensors.index.json")) as f:
+        index = json.load(f)["weight_map"]
+    by_file: dict = {}
+    for n in names:
+        by_file.setdefault(index[n], []).append(n)
+    out = {}
+    for fname, ns in by_file.items():
+        with safe_open(os.path.join(path, fname), "pt", device="cpu") as f:
+            for n in ns:
+                out[n] = f.get_tensor(n).to(device)
+    return out
+
+
+def weights(model, kinds: list[str]) -> None:
+    """Check mode, at build: the tensors the launches read of layers 0, 1 and 3
+    (SGLang's params, its AITER-shuffled experts and FP8 projections un-shuffled)
+    against the checkpoint's bytes. A layout SGLang changed would not fault, it
+    would produce plausible garbage."""
+    from sgl_amd_mono.qwen38_flash_next.gfx950 import packing
+    from sgl_amd_mono.qwen38_flash_next.gfx950 import weights as views
+
+    path, layers = _checkpoint_dir(), model.model.layers
+    for i, kind in CHECKED_LAYERS.items():
+        assert kinds[i] == kind, (i, kinds[i])
+        layer, p = layers[i], f"{PREFIX}layers.{i}."
+        small = views.checkpoint_dict(layer, kind, layer.ple is not None)
+        table = views.GDN_PROJ if kind == "gdn" else views.QSA_PROJ
+        proj = views.proj_params(layer, table)
+        names = [p + k for k in small]
+        names += [f"{p}{x}.{y}" for k in proj for x in PROJ_SOURCES[kind][k] for y in ("weight", "weight_scale")]  # fmt: skip
+        for e in CHECKED_EXPERTS:
+            src = _expert_name(e)
+            names += [f"{p}{src}.{w}_proj.{y}" for w in ("gate", "up", "down") for y in ("weight", "weight_scale")]  # fmt: skip
+        ref = _load(path, names, layer.mlp.experts.w13_weight.device)
+        bad = [
+            k
+            for k, t in small.items()
+            if not torch.equal(t.float().reshape(-1), ref[p + k].float().reshape(-1))
+        ]
+        for k, (w, sc) in proj.items():
+            srcs = PROJ_SOURCES[kind][k]
+            ref_w = torch.cat([ref[f"{p}{x}.weight"] for x in srcs]).view(torch.uint8)
+            ref_s = torch.cat([ref[f"{p}{x}.weight_scale"].float().reshape(-1) for x in srcs])  # fmt: skip
+            n = ref_w.shape[0]
+            got = packing.unshuffle16(w)
+            if not (
+                torch.equal(got[:n], ref_w)
+                and torch.equal(sc[:n], ref_s)
+                and not got[n:].any()
+            ):
+                bad.append(k)
+        moe = views.moe_params(layer.mlp.experts)
+        for e in CHECKED_EXPERTS:
+            src = _expert_name(e)
+            got = packing.unshuffle_moe_expert(moe, e)
+            want = [
+                ref[f"{p}{src}.{w}_proj.{y}"].view(torch.uint8)
+                for y in ("weight", "weight_scale")
+                for w in ("gate", "up", "down")
+            ]
+            bad += [f"expert {e} {n}" for n, g, r in zip(("gate", "up", "down", "gate_s", "up_s", "down_s"), got, want) if not torch.equal(g, r)]  # fmt: skip
+        del ref, proj
+        if bad:
+            logger.error(
+                "monokernel check violation: layer %d reads tensors that differ from "
+                "the checkpoint: %s",
+                i,
+                ", ".join(bad),
+            )
+        else:
+            logger.info(
+                "monokernel check weights layer %d: %d tensors, %d projections and "
+                "%d experts equal the checkpoint",
+                i,
+                len(small),
+                len(table),
+                len(CHECKED_EXPERTS),
+            )
diff --git a/sgl_amd_mono/qwen38_flash_next/draft.py b/sgl_amd_mono/qwen38_flash_next/draft.py
new file mode 100644
index 0000000..51d0e81
--- /dev/null
+++ b/sgl_amd_mono/qwen38_flash_next/draft.py
@@ -0,0 +1,334 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Qwen3.8-Flash-Next's MTP draft on gfx950: its spec and forward (RFC #43949).
+
+The NEXTN draft runs its own steps: a draft extend of R requests x 4 rows
+(DRAFT_EXTEND_V2) and the chain's draft decode steps of R x 1 (DECODE on the
+draft's runner). Monokernel API version 1 routes a draft model by the target's
+key, ("target_verify", R, draft tokens), which the draft never runs, so the spec
+routes the draft's own steps itself: at build, ``_route_draft_steps`` puts a
+wrapper in front of the model's forward, before the runtime installs its own
+over it. The wrapper routes a step by its forward mode, batch size, rows and
+hidden-state buffer alone, so a captured graph replays the decision made at
+capture, as a routed step does. It relies on every draft call site calling the
+instance attribute ``model.forward`` (pinned by a unit test), and does itself
+what the runtime does for a routed step, checking the draft's attention backend
+("qsa") once per step mode. It can move to SGLang if a later monokernel API
+routes a draft's own steps.
+
+Every draft extend and draft decode step of 1 to 8 requests runs the launch: one
+the launch cannot read raises instead of running SGLang's forward; larger steps
+run SGLang's forward. ``_build`` turns SGLang's QSA MTP index sharing off for the
+draft: with it on, SGLang's draft decode reuses the selection its own draft extend
+stored, which a launched extend never writes, so a batch growing past 8 requests
+would decode with a stale selection. SGLang's capture check never sees a draft
+step, so this module logs each draft key the first time it launches. Check mode
+(``SGLANG_AMD_MONO_CHECK``) does not cover the draft yet, and fault injection arms
+the target's launches only.
+
+A draft step is one launch (``gfx950/runner.DraftRunner``): the MTP input fusion
+(the token embedding and the target's hyper-connection hidden states, each
+normalized and projected), the QSA decoder layer and the draft's mixer;
+``_Draft.forward`` returns what ``Qwen4ExpForCausalLMMTP.forward`` does. The
+weights are SGLang's, read in place, except the copies logged at startup: the
+hyper-connection mixers, router and input-fusion projections packed for the MFMA
+tiles, and the FP8 projections SGLang keeps row-major, zero-padded in AITER's
+shuffle.
+"""
+
+from __future__ import annotations
+
+import functools
+import logging
+from typing import Optional
+
+try:
+    from sglang.kernels.plugin_kernels.amd.spec import (
+        DeviceLimits,
+        Feature,
+        MonoSpec,
+        Requirements,
+    )
+except ModuleNotFoundError:  # SGLang before sgl-project/sglang#45389
+    from sglang.srt.monokernels.spec import (
+        DeviceLimits,
+        Feature,
+        MonoSpec,
+        Requirements,
+    )
+
+from sgl_amd_mono.common.plan import BLOCKS
+from sgl_amd_mono.qwen38_flash_next import spec as target
+
+logger = logging.getLogger(__name__)
+
+# The SGLang names this module reads, by file under the sglang package (``f(p)``: a
+# parameter, ``"x"``: a string literal); test/unit/test_contract.py pins them.
+SGLANG_READS = {
+    "kernels/plugin_kernels/amd/spec.py|srt/monokernels/spec.py": (
+        "DeviceLimits",
+        "Feature",
+        "MonoSpec",
+        "Requirements",
+    ),
+    "srt/models/qwen4_exp_mtp.py": (
+        "Qwen4ExpForCausalLMMTP",
+        "model",
+        "lm_head",
+        "logits_processor",
+        "_set_hc_logits_hidden_states",
+        "forward(input_ids)",
+        "forward(positions)",
+        "forward(forward_batch)",
+        "forward(input_embeds)",
+    ),
+    "srt/models/qwen3_5.py": ("layers", "embed_tokens", "rotary_emb"),
+    "srt/layers/radix_attention.py": ("layer_id",),
+    "srt/model_executor/forward_batch_info.py": (
+        "spec_info",
+        "forward_mode",
+        "batch_size",
+        "is_draft_extend_v2",
+        "is_decode",
+    ),
+    "srt/model_executor/forward_context.py": ("get_attn_backend",),
+    "srt/layers/attention/base_attn_backend.py": ("decode_attention_backend_str",),
+    "srt/layers/attention/qsa/glue.py": ("resolve_qsa_sparse_backend",),
+    "srt/layers/attention/qwen_sparse_attn_backend.py": ("_mtp_shared_sparse_indices",),
+    "srt/configs/qwen4_exp.py": ("text_config", "index_share_for_mtp_iteration"),
+    # the draft worker reads the flag from the draft's config, text_config first,
+    # when it sets up the draft's attention backends, after the draft's build
+    "srt/speculative/eagle_worker_v2.py": (
+        '"index_share_for_mtp_iteration"',
+        "_configure_qsa_mtp_index_share",
+    ),
+    "srt/speculative/draft_utils.py": ('"qsa"',),
+    "srt/speculative/*.py": ("hidden_states",),
+    "srt/runtime_context.py": ("get_parallel", '"tp_size"'),
+}
+
+# The draft runs on its own QSA backends whatever --speculative-draft-attention-backend
+# says (speculative/draft_utils.py stamps them "qsa"); the launch writes their caches.
+DRAFT_ATTENTION_BACKENDS = frozenset({"qsa"})
+
+
+def _tokens_per_request(model) -> int:
+    """A draft extend's rows a request: the target's verify rows."""
+    return target.TOKENS
+
+
+def _model_disable_reasons(model, hf_config, copies: dict) -> list[str]:
+    from sglang.srt.runtime_context import get_parallel
+
+    from sgl_amd_mono.qwen38_flash_next.gfx950 import weights
+
+    reasons = []
+    if get_parallel().tp_size != 1:
+        reasons.append("the draft launch runs the MTP layer on one GPU")
+    return reasons + weights.mtp_reasons(model)
+
+
+def _step_backend() -> Optional[str]:
+    """The decode attention backend the current step runs on."""
+    from sglang.srt.model_executor.forward_context import get_attn_backend
+
+    return get_attn_backend().decode_attention_backend_str
+
+
+def _shares_mtp_sparse_indices() -> bool:
+    """Whether the current step's QSA backend holds SGLang's shared MTP selection
+    (index sharing on)."""
+    from sglang.srt.layers.attention.qsa.glue import resolve_qsa_sparse_backend
+    from sglang.srt.model_executor.forward_context import get_attn_backend
+
+    backend = resolve_qsa_sparse_backend(get_attn_backend())
+    return getattr(backend, "_mtp_shared_sparse_indices", None) is not None
+
+
+def _turn_off_mtp_index_share(hf_config) -> None:
+    """Turn SGLang's QSA MTP index sharing off for the draft (see the module
+    docstring). The draft worker reads the flag from the draft's own config,
+    text_config first, after the build and before it sets up the draft's
+    attention backends, so no shared selection is ever created."""
+    text = target._text(hf_config)
+    was = getattr(text, "index_share_for_mtp_iteration", None)
+    for config in (text, hf_config):
+        config.index_share_for_mtp_iteration = False
+    logger.info(
+        "monokernel qwen38_flash_next MTP draft: SGLang's QSA MTP index sharing off "
+        "(index_share_for_mtp_iteration %r -> False), so every draft decode "
+        "selects its own blocks",
+        was,
+    )
+
+
+class _Draft:
+    """The draft's launch and its forward."""
+
+    def __init__(self, lm, runner):
+        self.lm, self.runner = lm, runner
+        self.seen: set = set()
+        self.backend_checked: set = set()
+
+    def takes(self, forward_batch, input_embeds=None) -> bool:
+        """Whether the launch runs this step: static properties of the step only
+        (mode, batch size, rows, the hidden-state buffer), so graph-capture safe.
+
+        A draft extend or draft decode of 1 to ``max_reqs`` requests the launch
+        cannot read raises, eager or in capture: SGLang's forward must not run a
+        draft step the launch serves (see the module docstring)."""
+        from sgl_amd_mono.qwen38_flash_next.gfx950.runner import (
+            HC_DIM,
+            draft_eligible,
+        )
+
+        r, fb = self.runner, forward_batch
+        hidden = None if fb.spec_info is None else fb.spec_info.hidden_states
+        if input_embeds is None and draft_eligible(fb, hidden, r.L_ext, r.max_reqs):
+            return True
+        mode, R = fb.forward_mode, int(fb.batch_size)
+        is_extend = mode.is_draft_extend_v2()
+        if not (is_extend or mode.is_decode()) or not 1 <= R <= r.max_reqs:
+            return False
+        if input_embeds is not None:
+            what = "input embeddings"
+        elif hidden is None:
+            what = "no hidden states"
+        else:
+            strided = "" if hidden.is_contiguous() else " (strided)"
+            what = f"hidden states {hidden.dtype} {tuple(hidden.shape)}{strided}"
+        key = (mode.name, R, int(fb.input_ids.numel()))
+        rows = R * r.L_ext if is_extend else R
+        raise ValueError(
+            f"Qwen3.8-Flash-Next MTP draft step {key} has {what}: the launch takes "
+            f"every draft step of 1 to {r.max_reqs} requests, {rows} rows of "
+            f"contiguous bf16 [rows, {HC_DIM}] hidden states and no input "
+            "embeddings; refusing to run SGLang's draft forward"
+        )
+
+    def check_backend(self, forward_batch) -> None:
+        """Refuse a draft step on an attention backend whose caches the launch does
+        not write, or that shares one QSA selection across the draft steps, once
+        per step mode (what the runtime does for routed steps)."""
+        mode = forward_batch.forward_mode.name
+        if mode in self.backend_checked:
+            return
+        backend = _step_backend()
+        if backend not in DRAFT_ATTENTION_BACKENDS:
+            raise ValueError(
+                f"--monokernel-backend amd: {SPEC.name} needs a draft attention "
+                f"backend in {sorted(DRAFT_ATTENTION_BACKENDS)}, this {mode} step's "
+                f"is {backend!r}"
+            )
+        if _shares_mtp_sparse_indices():
+            raise ValueError(
+                f"--monokernel-backend amd: {SPEC.name}: this {mode} step's QSA "
+                "backend shares one sparse selection across the MTP draft steps "
+                "(index_share_for_mtp_iteration on); SGLang's draft decode would "
+                "read a selection the launched draft extend never writes"
+            )
+        self.backend_checked.add(mode)
+
+    def step(self, input_ids, forward_batch):
+        """``Qwen4ExpForCausalLMMTP.forward`` for a step the launch takes."""
+        lm, fb = self.lm, forward_batch
+        key = (fb.forward_mode.name, int(fb.batch_size), int(input_ids.numel()))
+        if key not in self.seen:
+            self.seen.add(key)
+            logger.info("monokernel qwen38_flash_next MTP draft runs %s", key)
+        x, hc = self.runner.launch(fb, fb.spec_info.hidden_states)
+        out = lm.logits_processor(input_ids, x, lm.lm_head, fb)
+        lm._set_hc_logits_hidden_states(out, hc, fb)
+        return out
+
+    def forward(
+        self, plan, input_ids, positions, forward_batch, input_embeds=None, *_, **kw
+    ):
+        """A step the runtime routes: the launch, or SGLang's forward. The draft's
+        own steps reach the launch through ``_route_draft_steps``."""
+        if self.takes(forward_batch, input_embeds):
+            return self.step(input_ids, forward_batch)
+        lm = self.lm
+        return type(lm).forward(
+            lm, input_ids, positions, forward_batch, input_embeds, **kw
+        )
+
+
+def _route_draft_steps(model, draft: _Draft) -> None:
+    """The draft-step wrapper in front of the model's forward (see the module
+    docstring); every other step runs the forward it wraps. Runs in build, so the
+    runtime's forward wraps this one."""
+    standard = model.forward
+
+    # Graph runners inspect the original parameters to select forward arguments.
+    @functools.wraps(standard)
+    def forward(*args, **kwargs):
+        # (input_ids, positions, forward_batch, input_embeds=None, ...)
+        fb = kwargs["forward_batch"] if "forward_batch" in kwargs else args[2]
+        embeds = kwargs.get("input_embeds", args[3] if len(args) > 3 else None)
+        if draft.takes(fb, embeds):
+            draft.check_backend(fb)
+            ids = kwargs["input_ids"] if "input_ids" in kwargs else args[0]
+            return draft.step(ids, fb)
+        return standard(*args, **kwargs)
+
+    model.forward = forward
+
+
+def _build(model, hf_config, ctx) -> _Draft:
+    import torch
+
+    from sgl_amd_mono.qwen38_flash_next.gfx950 import weights
+    from sgl_amd_mono.qwen38_flash_next.gfx950.runner import DraftRunner
+
+    _turn_off_mtp_index_share(hf_config)
+    params = weights.param_ptrs(model)
+    views = weights.mtp_views(model, ctx.copies, params)
+    layer = model.model.layers[0]
+    rope = layer.rotary_emb
+    runner = DraftRunner(
+        views=views,
+        embed_w=model.model.embed_tokens.weight,
+        cos_sin=lambda: rope.cos_sin_cache_as(torch.bfloat16),
+        layer_id=layer.attn.layer_id,
+        ntok_extend=target.TOKENS,
+        max_reqs=target.MAX_R,
+        eos_token_id=int(target._text(hf_config).eos_token_id),
+        device=model.model.embed_tokens.weight.device,
+        # SGLANG_AMD_MONO_FAULT_INJECT stalls the target's launches only, so the
+        # fault-injection test knows which launch stopped
+        fault=None,
+    )
+    runner.set_deadline(ctx.deadline_s)
+    draft = _Draft(model, runner)
+    _route_draft_steps(model, draft)
+    logger.info(
+        "monokernel qwen38_flash_next MTP draft: draft extend steps of up to %d x %d "
+        "rows and draft decode steps of up to %d x 1 are routed by the spec's "
+        "wrapper of the draft's forward, and one it cannot launch raises; each key "
+        "logs 'MTP draft runs' at its first launch",
+        runner.max_reqs,
+        runner.L_ext,
+        runner.max_reqs,
+    )
+    return draft
+
+
+SPEC = MonoSpec(
+    name="qwen38_flash_next_mtp_draft_hip",
+    devices={
+        "gfx950": DeviceLimits(
+            widths=tuple(range(1, target.MAX_R * target.TOKENS + 1)),
+            tp_sizes=(target.TP,),
+            resident_blocks=BLOCKS,
+        )
+    },
+    features=frozenset({Feature.SPECULATIVE_DECODING}),
+    # the launcher checks the target's requirements; a draft step is checked
+    # against these by the draft-step wrapper
+    requires=Requirements(attention_backends=DRAFT_ATTENTION_BACKENDS),
+    numerics=target.NUMERICS,
+    model_disable_reasons=_model_disable_reasons,
+    build=_build,
+    api_version=1,  # SGLang's MONOKERNEL_API_VERSION
+    tokens_per_request=_tokens_per_request,
+)
diff --git a/sgl_amd_mono/qwen38_flash_next/gfx950/__init__.py b/sgl_amd_mono/qwen38_flash_next/gfx950/__init__.py
new file mode 100644
index 0000000..187ad9f
--- /dev/null
+++ b/sgl_amd_mono/qwen38_flash_next/gfx950/__init__.py
@@ -0,0 +1,4 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Qwen3.8-Flash-Next's gfx950 launches: the FlyDSL kernel of a launch of decoder
+layers (``kernel``), its layouts and packing, the layer views of SGLang's weights
+(``weights``), and the host runner that binds caches and launches (``runner``)."""
diff --git a/sgl_amd_mono/qwen38_flash_next/gfx950/config.py b/sgl_amd_mono/qwen38_flash_next/gfx950/config.py
new file mode 100644
index 0000000..781e356
--- /dev/null
+++ b/sgl_amd_mono/qwen38_flash_next/gfx950/config.py
@@ -0,0 +1,98 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Qwen3.8-Flash-Next monokernel geometry (``amd/Qwen3.8-Flash-Next-Quark-MXFP4-
+AttnFP8-PLEFP8``, SGLang's Qwen4-Exp) and the build key of one launch."""
+
+import msgspec
+
+# the text config's shapes, which the kernel builds in
+HIDDEN = 2560
+HC = 4
+HC_DIM = HIDDEN * HC  # 10240: the hyper-connection residual streams
+HC_LOWRANK = 320
+EPS = 1e-6
+# Gated DeltaNet
+GDN_HK = 16
+GDN_HV = 48
+GDN_DK = 128
+GDN_DV = 128
+GDN_KEY_DIM = GDN_HK * GDN_DK  # 2048
+GDN_VAL_DIM = GDN_HV * GDN_DV  # 6144
+GDN_CONV_DIM = 2 * GDN_KEY_DIM + GDN_VAL_DIM  # 10240
+GDN_QKVZ = 2 * GDN_KEY_DIM + 2 * GDN_VAL_DIM  # 16384
+# MoE: 512 routed MXFP4 experts, top-10, and the shared expert fused at index 512
+N_EXPERTS = 512
+TOPK = 10
+MOE_INTER = 640
+
+# a launch's rows: R requests x L verify tokens (row t: request t // L, step t % L)
+MAX_R = 8
+MAX_L = 4
+MAX_T = 32
+
+
+class ConvStrides(msgspec.Struct, frozen=True):
+    """Element strides (draft step, channel, window, request row) of a GDN layer's
+    intermediate conv-window view (SGLang's ``intermediate_conv_window[0]``)."""
+
+    step: int = 30720
+    channel: int = 3
+    window: int = 1
+    row: int = 4 * 30720
+
+
+class MonoBuild(msgspec.Struct, frozen=True):
+    """One launch: its layers and rows, and the cache strides it is compiled for;
+    every field is a scalar of the JIT cache key (``plan.key_tuple``)."""
+
+    plan: str  # the launch's layer kinds, comma-separated (gdn | qsa)
+    nreq: int  # R requests
+    ntok: int  # of L verify tokens each
+    rtt_stride: int = 0  # req_to_token row stride (int32 elements)
+    # element stride between the 3 MRoPE position axes (0: 1-D text positions)
+    pos_stride: int = 1
+    map_i64: bool = False  # the request -> mamba slot map is int64
+    ple_first: bool = False  # the launch starts with layer 1's PLE
+    final_mix: bool = False  # it ends with the model-level mixer
+    prelude: bool = False  # it embeds the tokens (launch 0)
+    eos_token_id: int = 0
+    # SGLang's verify scratch strides: the intermediate conv window, and elements
+    # per request row of intermediate_ssm, of the PLE intermediate short-conv state
+    # (bf16) and of the n-gram intermediate context (int64)
+    iconv: ConvStrides = msgspec.field(default_factory=ConvStrides)
+    issm_row: int = 4 * GDN_HV * GDN_DK * GDN_DV
+    ple_ist_row: int = 4 * HC_DIM * 9
+    ictx_row: int = 8
+    # layer 0's input: "global" the previous launch, "embed" the prelude's token
+    # embedding, "mtp" the MTP input fusion
+    first_src: str = "global"
+    # the GDN SSM states are bf16 (SGLANG_MAMBA_SSM_DTYPE=bfloat16): the recurrence
+    # stays f32 and the states are rounded when stored, as SGLang does
+    ssm_bf16: bool = False
+    # each request's first sequence position is its seq_lens entry (a target verify,
+    # whose RoPE positions may be MRoPE's), not its first row's position
+    seq_p0: bool = False
+    # index-key ring slots a request in SGLang's QSA pool: 4 (one group), or 8 (two
+    # groups, so a verify window never overwrites the pending group's members)
+    ring: int = 4
+    # SGLANG_AMD_MONO_FAULT_INJECT: the wait this launch stalls at (0: none), once
+    # fault_after steps have run
+    fault_site: int = 0
+    fault_after: int = 0
+
+    def __post_init__(self) -> None:
+        kinds = self.layers
+        if not kinds or any(k not in ("gdn", "qsa") for k in kinds):
+            raise ValueError(f"plan {self.plan!r}: layer kinds are gdn or qsa")
+        if not (1 <= self.nreq <= MAX_R and 1 <= self.ntok <= MAX_L):
+            raise ValueError(
+                f"{self.nreq} requests x {self.ntok} tokens: the kernel takes 1..{MAX_R}"
+                f" requests of 1..{MAX_L} tokens"
+            )
+        if self.nreq * self.ntok > MAX_T:
+            raise ValueError(f"{self.nreq * self.ntok} rows, past {MAX_T}")
+        if self.first_src not in ("global", "embed", "mtp"):
+            raise ValueError(f"first_src {self.first_src!r}")
+
+    @property
+    def layers(self) -> tuple:
+        return tuple(self.plan.split(",")) if self.plan else ()
diff --git a/sgl_amd_mono/qwen38_flash_next/gfx950/device.py b/sgl_amd_mono/qwen38_flash_next/gfx950/device.py
