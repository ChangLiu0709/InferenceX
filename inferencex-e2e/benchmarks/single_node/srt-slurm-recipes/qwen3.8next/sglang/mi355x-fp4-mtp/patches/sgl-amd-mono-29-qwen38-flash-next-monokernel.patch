+# SPDX-License-Identifier: Apache-2.0
+"""Compile-time geometry and scratch (mailbox) layout of the Qwen3.8-Flash-Next
+launch, kept free of FlyDSL so it is testable without a GPU.
+
+A launch serves R requests x L verify tokens = S rows (S <= 32). Every activation
+mailbox is row-major [S][n], row t = request t // L, draft step t % L."""
+
+from sgl_amd_mono.common.plan import BLOCKS, THREADS, WAVES, padded
+
+from .config import (
+    GDN_HV,
+    GDN_QKVZ,
+    HC_DIM,
+    HC_LOWRANK,
+    HIDDEN,
+    MOE_INTER,
+    N_EXPERTS,
+    TOPK,
+)
+
+assert (BLOCKS, THREADS, WAVES) == (256, 512, 8)  # one CTA per MI355X CU, co-resident
+MOE_PAIR = TOPK + 1  # (row, expert) pairs per row: top-10 routed + the shared expert
+
+# hyper-connection mix
+MIX_KSPLIT = 10  # down GEMV split-K across CTAs (1024-wide K slices)
+MIX_DOWN_RG = HC_LOWRANK // 16 + 1  # 20 row tiles + the combine-gate tile
+MIX_DOWN_TASKS = MIX_DOWN_RG * MIX_KSPLIT  # 210
+MIX_UP_TASKS = HIDDEN // 16  # 160 (each covers 16 outputs x 4 branches)
+# sum-of-squares partials per (token, branch) published with a residual stream (one
+# per 16-row group)
+NPART = HIDDEN // 16
+
+# GDN
+IP_ROWS = GDN_QKVZ + 2 * GDN_HV  # 16480: [q k v | z | b | a]
+IP_RG_MAIN = GDN_QKVZ // 16  # 1024 = 4 per CTA; the core tasks compute the b/a rows
+MAX_CORE_SPLIT = 8  # the scratch's bound on core_split
+
+
+def core_split(T):
+    """V-row splits per value head of the GDN core: 4 for every T (8 would need 384
+    CTAs)."""
+    return 4
+
+
+def core_geom(split):
+    """(V rows per task, tasks, threads per V row, K elements per thread, xor offsets
+    of a row reduce) of the GDN core at ``split``."""
+    rows = 128 // split
+    rpt = 512 // rows
+    kpt = 128 // rpt  # state words per thread
+    red_offs = tuple(rpt >> k for k in range(1, rpt.bit_length()))
+    return rows, GDN_HV * split, rpt, kpt, red_offs
+
+
+OUT_RG = HIDDEN // 16  # 160
+
+# MoE
+SHARED_EXPERT = N_EXPERTS  # index of the shared expert in the stacked arrays
+ROUTER_ROWS = N_EXPERTS + 16  # 512 routed logits + shared gate + 15 zero rows
+ROUTER_RG = ROUTER_ROWS // 16  # 33
+# MXFP4 experts in SGLang's AITER layout. get_moe_weight_sizes(is_aiter_moe) pads the
+# intermediate dim to the AITER alignment (w2 row 320 -> 384 bytes): FusedMoE w13
+# [513, 2 * 768, 1280] (gate rows 0..639, zero rows to 767, up rows 768..1407, zero
+# rows to 1535), w2 [513, 2560, 384] (K 640..767 zero); process_weights_after_loading
+# applies shuffle_weight(w, (16, 16)) and e8m0_shuffles the scales over the flattened
+# [E * rows, groups] (groups padded to 8). The kernel reads only the real rows / K
+# (gate tiles 0..39, up tiles 48..87, down K chunks 0..4).
+MOE_INTER_PAD = 768
+# MXFP4 gate/up tasks per expert (40): gate tile n + up tile n + UP_TILE0
+GU_PAIRS = MOE_INTER // 16
+UP_TILE0 = MOE_INTER_PAD // 16  # 48: first up row tile of w13
+DN_RG = HIDDEN // 16  # 160
+GU_BYTES = 2 * MOE_INTER_PAD * HIDDEN // 2  # fp4 bytes per expert (w13)
+GU_SGROUPS = HIDDEN // 32  # 80
+GU_SBYTES = 2 * MOE_INTER_PAD * GU_SGROUPS
+DN_BYTES = HIDDEN * MOE_INTER_PAD // 2  # w2: 384-byte rows
+DN_SGROUPS = (MOE_INTER_PAD // 32 + 7) // 8 * 8  # 24
+DN_SBYTES = HIDDEN * DN_SGROUPS
+
+
+def max_slots(T):
+    """Union of routed experts of T tokens + the shared expert."""
+    return min(TOPK * T, N_EXPERTS) + 1
+
+
+def max_groups(T, sg):
+    """MoE down K-groups of ``sg`` expert slots (partials summed by the combine)."""
+    return (max_slots(T) + sg - 1) // sg
+
+
+def kphases(T):
+    """K phases of the K=2560 activation GEMMs: [T][2560] bf16 rows fit the LDS for
+    T <= 16; above, the CTA stages the activation in two K halves (accumulators of
+    all its row tiles kept across the halves)."""
+    return 1 if T <= 16 else 2
+
+
+def gu_kphases(T):
+    """K halves of the MoE gate/up: the staged [T][2560] bf16 rows + the route tables
+    fit the LDS for T <= 28; above, a CTA stages one K half and publishes f32 gate/up
+    partials (summed by the down staging)."""
+    return 1 if T <= 28 else 2
+
+
+def dn_sg(T):
+    """Expert slots per MoE down K-group: the staged [T][SG * 640] bf16 mid of a
+    group must fit the LDS."""
+    return 4 if T <= 28 else 3
+
+
+# QSA (full attention) layer
+# [q | gate per head | k | v | index q (4 x 128) + index k (128)]
+QP_ROWS = 24 * 512 + 512 + 512 + 640
+QP_RG = QP_ROWS // 16  # 872
+QP_K_OFF = 24 * 512
+QP_V_OFF = QP_K_OFF + 512
+QP_IDX_OFF = QP_V_OFF + 512
+# top-512 selection: an exact top-512 per segment (16 blocks a thread), then a merge
+SEG_BLOCKS = 8192
+NSEG_MAX = 9
+MAX_BLOCKS = SEG_BLOCKS * NSEG_MAX  # 73728 compressed blocks
+MAX_CTX = MAX_BLOCKS * 4  # 294912 >= max_position_embeddings (262144) + verify tokens
+ATT_CHUNK = 64  # tokens per attention split
+ATT_CHUNKS = 2048 // ATT_CHUNK + 1  # 32 block chunks + 1 tail chunk
+ATT_TASKS = ATT_CHUNKS  # per token; one task covers both kv heads
+PART_STRIDE = 24 * 256 + 2 * 24  # per task: o[24][256], m[24], l[24]
+MERGE_TASKS = 24  # one per (token, head)
+PREP_Q_TASKS = 24  # CTAs [0, 24): one attention q head each (all tokens)
+PREP_K_CTA = 24  # CTAs 24, 25: k head (norm+rope) + v -> KV cache
+# CTAs [26, 26 + R): index q + index k ring / compress of request r (its tokens, in
+# order)
+PREP_IDX_CTA0 = 26
+
+
+def sel2_cta0(T):
+    """CTAs [256 - T, 256): merge of the segment top-512s of row t (long contexts)."""
+    return 256 - T
+
+
+SEL_STRIDE = 1026  # pairs per token: (block, loc) as 2 pairs each, count at pair 1024
+
+
+def cnew_slots(L):
+    """Compressed blocks completed inside one request's L verify tokens."""
+    return L // 4 + 2
+
+
+# per-layer pointer table slots
+P_HCA_NORM, P_HCA_DOWN, P_HCA_UP, P_HCA_INJ = 0, 1, 2, 3
+P_IP, P_CONV_W, P_NEG_A, P_DT_BIAS, P_NORM_W, P_OUT = 4, 5, 6, 7, 8, 9
+P_CONV_STATE, P_SSM_STATE = 10, 11
+P_HCM_NORM, P_HCM_DOWN, P_HCM_UP, P_HCM_INJ = 12, 13, 14, 15
+P_ROUTER, P_GU, P_GU_S, P_DN, P_DN_S = 16, 17, 18, 19, 20
+# QSA reuses P_IP (fused q/k/v/index projection) and P_OUT (o_proj)
+P_QNORM, P_KNORM, P_IQNORM, P_IKNORM = 5, 6, 7, 8
+P_KBUF, P_VBUF, P_RING, P_COMP = 10, 11, 21, 22
+P_BA = 23  # GDN: row-major [b (48) ; a (48)] x HIDDEN bf16
+# PLE (layer 1 only): fused into the start of the launch whose first layer carries it
+P_PLE_W, P_PLE_NK, P_PLE_NQ, P_PLE_NC, P_PLE_CW, P_PLE_STATE = 24, 25, 26, 27, 28, 29
+# GDN verify scratch: per-draft-step SSM states / conv windows (batch row 0)
+P_ISSM, P_ICONV = 30, 31
+# PLE verify scratch: per-draft-step short-conv windows (GDN rows leave P_RING free)
+P_PLE_ISTATE = 21
+PLE_ROWS = HC_DIM + HIDDEN  # [key_proj (10240) ; value_proj (2560)]
+PLE_RG = PLE_ROWS // 16  # 800
+PLE_STATE_LEN = 9
+PLE_STATE_SLOT_BYTES = HC_DIM * PLE_STATE_LEN * 2
+PLE_CH_PER_CTA = HC_DIM // 256  # 40
+PLE_PARTS = HIDDEN // PLE_CH_PER_CTA  # 64 ple_h producers per branch
+N_PTR = 40
+# FP8 projections: F32 per-output-channel weight scales
+P_IP_S, P_OUT_S, P_BA_S = 32, 33, 34
+# QSA: SGLang keeps qkv_proj and indexer.index_qk_proj as separate FP8 params (rows
+# [0, 832 * 16) / the rest of QP)
+P_IP2, P_IP2_S = 35, 36
+QP_RG_QKV = (24 * 512 + 512 + 512) // 16  # 832
+BA_ROWS = 128  # SGLang pads in_proj_ba (96 rows) to 128 for AITER's CK GEMM
+# global row (index n_layers of the table)
+G_POS, G_LOC, G_REQ, G_SEQ = 0, 1, 2, 3
+G_RTT, G_COS, G_ROPEPOS, G_MAMBA_MAP = 4, 5, 6, 7
+G_PLE_EMB = 9  # (slot 8 is unused)
+G_FIN_OUT = 10  # final mixer output x [T, HIDDEN] bf16 (final_mix launches)
+G_HIN_SSQ, G_HOUT_SSQ = 11, 12  # f32 [T, 4, NPART] sum-of-squares of h_in / h_out
+G_INPUT_IDS, G_EMBED_W = 13, 14
+G_NGRAM_W, G_NGRAM_SCALE, G_NGRAM_CTX, G_NGRAM_META = 15, 16, 17, 18
+# int64 [T, 2] per-draft-step n-gram history (batch row 0 of intermediate_context)
+G_NGRAM_ICTX = 19
+# MTP draft launches (first_src "mtp"): input fusion of the draft model
+# bf16 [T, HC_DIM] target (or previous draft step) hyper-connection hidden states
+G_MTP_HIN = 20
+# pre_fc_norm_embedding [HIDDEN], pre_fc_norm_hidden [HC_DIM] (bf16)
+G_MTP_PE, G_MTP_PH = 21, 22
+G_MTP_FCE, G_MTP_FCH = 23, 24  # packed bf16 fc_embedding / fc_hidden [HIDDEN, HIDDEN]
+NGRAM_HEADS, NGRAM_DIM, HEADS_PER_NGRAM = 16, 160, 8
+PRELUDE_CTA0 = 224  # CTAs [224, 224 + T): PLE n-gram rows of verify row t
+CONV_SLOT_BYTES = 10240 * 3 * 2  # bf16 [10240, 3] per mamba slot
+SSM_SLOT_BYTES = 48 * 128 * 128 * 4  # f32 [48, 128, 128] per mamba slot
+SSM_STEP_WORDS = 48 * 128 * 128
+LAUNCH_SLOTS = 64  # tag = step * LAUNCH_SLOTS + launch_id + 1
+
+
+def scratch_layout(n_layers: int, T: int, R: int = 1):
+    """Byte offsets of every tagged-pair mailbox, one region per (layer, stage), and
+    the total size. T = rows, R = requests."""
+    regions = {}
+    off = 0
+
+    def add(name, pairs):
+        nonlocal off
+        regions[name] = off
+        off += padded(pairs * 8, 256)
+
+    for layer in range(n_layers):
+        p = f"L{layer}."
+        add(p + "qp", T * QP_ROWS // 2)
+        add(p + "q", T * 24 * 256 // 2)
+        add(p + "kvnew", T * 1024 // 2)
+        add(p + "qi", T * 512 // 2)
+        add(p + "cnew", R * cnew_slots(T // R) * 64)  # [R][CN][64]
+        add(p + "ilog", T * MAX_BLOCKS)
+        add(p + "sel", T * SEL_STRIDE)
+        # per (token, segment): key bits of the segment's top-512
+        add(p + "cand_k", T * NSEG_MAX * 512)
+        add(p + "cand_bl", T * NSEG_MAX * 512 * 2)  # (block, KV loc)
+        add(p + "part", T * ATT_TASKS * PART_STRIDE)
+        add(p + "og", T * 24 * 256 // 2)
+        add(p + "ple_kv", T * PLE_ROWS // 2)
+        add(p + "ple_h", T * HC_DIM // 2)
+        add(p + "ple_ssq", T * 4 * PLE_PARTS)
+        for hc in ("a", "m"):
+            add(p + hc + ".mixd", MIX_KSPLIT * T * HC_LOWRANK)
+            add(p + hc + ".mixx", T * HIDDEN // 2)  # bf16 pairs
+            add(p + hc + ".injp", MIX_KSPLIT * T * 4)
+        add(p + "ip", T * IP_ROWS // 2)  # bf16 pairs
+        # per (token, head, split) sum of squares of the GDN output
+        add(p + "ssq", T * GDN_HV * MAX_CORE_SPLIT)
+        # per (row, producer task) max |og| (the FP8 activation scale)
+        add(p + "og_amax", T * GDN_HV * MAX_CORE_SPLIT)
+        add(p + "h1", T * HC_DIM // 2)  # bf16 pairs
+        add(p + "h1ssq", T * 4 * NPART)
+        add(p + "logit", T * ROUTER_ROWS)  # f32
+        # (row, expert) pairs p = t * 11 + rank: bf16 h = silu(g) * u [p][640], and
+        # under gu_kphases 2 the f32 K-half-0 gate/up partials [p][1280]
+        add(p + "mid", MOE_PAIR * T * MOE_INTER // 2)
+        if gu_kphases(T) == 2:
+            add(p + "gupart", MOE_PAIR * T * 2 * MOE_INTER)
+        add(p + "dpart", max_groups(T, dn_sg(T)) * T * HIDDEN)  # f32 [group][T][2560]
+        add(p + "h2", T * HC_DIM // 2)  # bf16 pairs
+        add(p + "h2ssq", T * 4 * NPART)
+        # MTP input fusion output (layer-0 input of a draft launch)
+        add(p + "mtp_h", T * HC_DIM // 2)
+        add(p + "mtp_ssq", T * 4 * NPART)
+    return regions, off
diff --git a/sgl_amd_mono/qwen38_flash_next/gfx950/packing.py b/sgl_amd_mono/qwen38_flash_next/gfx950/packing.py
new file mode 100644
index 0000000..bc7ce91
--- /dev/null
+++ b/sgl_amd_mono/qwen38_flash_next/gfx950/packing.py
@@ -0,0 +1,342 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Host-side packing and pointer tables of the Qwen3.8-Flash-Next launches.
+
+The MXFP4 experts and the FP8 attention / GDN projections are SGLang's own params
+(AITER layouts), read in place; only the small bf16 tensors SGLang does not keep in
+the kernel's tile layout (hyper-connection mixers, router, PLE, MTP input fusion)
+are packed here. Plain torch: the kernel module does not import it, so it stays out
+of the kernels' cache key."""
+
+import torch
+
+from . import layout as LY
+from .config import HIDDEN, N_EXPERTS
+
+
+def pack_bf16(w: torch.Tensor) -> torch.Tensor:
+    """Pack BF16 ``[N, K]`` for the kernel's 16-row, 64-K MFMA tiles."""
+    rows, k = w.shape
+    if rows % 16 or k % 64:
+        raise ValueError(
+            f"BF16 matrix dimensions must be divisible by (16, 64), got {(rows, k)}"
+        )
+    w16 = w.view(torch.int16).reshape(rows // 16, 16, k // 64, 2, 4, 8)
+    return w16.permute(0, 2, 3, 4, 1, 5).contiguous().view(-1)
+
+
+def check_moe_params(m):
+    """Shape / dtype / layout asserts on the (sglang) MXFP4 MoE params the kernel reads."""
+    E = N_EXPERTS + 1
+    assert m["gu"].dtype == torch.uint8 and tuple(m["gu"].shape) == (
+        E,
+        2 * LY.MOE_INTER_PAD,
+        HIDDEN // 2,
+    ), m["gu"].shape
+    assert m["dn"].dtype == torch.uint8 and tuple(m["dn"].shape) == (
+        E,
+        HIDDEN,
+        LY.MOE_INTER_PAD // 2,
+    ), m["dn"].shape
+    assert tuple(m["gu_s"].shape) == (E, 2 * LY.MOE_INTER_PAD, LY.GU_SGROUPS), m[
+        "gu_s"
+    ].shape
+    assert tuple(m["dn_s"].shape) == (E, HIDDEN, LY.DN_SGROUPS), m["dn_s"].shape
+    for k in ("gu", "dn", "gu_s", "dn_s"):
+        assert m[k].is_contiguous() and m[k].element_size() == 1, k
+    assert m["gu"].numel() == E * LY.GU_BYTES and m["dn"].numel() == E * LY.DN_BYTES
+    assert (
+        m["gu_s"].numel() == E * LY.GU_SBYTES and m["dn_s"].numel() == E * LY.DN_SBYTES
+    )
+
+
+def pack_hc_down(w_down, w_inj=None):
+    """Mix down weights [320, HC_DIM] + one extra 16-row tile whose rows 0..3 are the
+    combine-gate (inject) rows: the down GEMM of a K-slice also yields the gate
+    partials."""
+    extra = torch.zeros(16, w_down.shape[1], dtype=w_down.dtype, device=w_down.device)
+    if w_inj is not None:
+        extra[: w_inj.shape[0]] = w_inj
+    return pack_bf16(torch.cat([w_down, extra], dim=0).contiguous())
+
+
+def pack_router(lw):
+    """Router rows: the 512 routed logits, the shared-expert gate, 15 zero rows."""
+    gate, shared = lw["mlp.gate.weight"], lw["mlp.shared_expert_gate.weight"]
+    pad = torch.zeros(15, HIDDEN, dtype=torch.bfloat16, device=gate.device)
+    return pack_bf16(torch.cat([gate, shared, pad], dim=0).contiguous())
+
+
+def pack_hc(lw, name):
+    p = f"{name}."
+    return {
+        "norm": lw[p + "hc_norm.weight"].contiguous(),
+        "down": pack_hc_down(
+            lw[p + "input_mix_weight_down.weight"], lw[p + "block_inject_weight.weight"]
+        ),
+        "up": pack_bf16(lw[p + "input_mix_weight_up.weight"].contiguous()),
+        "inj": lw[p + "block_inject_weight.weight"].contiguous(),
+    }
+
+
+def pack_gdn_layer(lw, moe, proj):
+    """A GDN layer's views. moe / proj: SGLang's FusedMoE params / FP8 projection
+    params {"ip", "out", "ba": (weight, scale)} of the layer (AITER layouts, read in
+    place)."""
+    a = "linear_attn."
+    (ip, ip_s), (out, out_s), (ba, ba_s) = proj["ip"], proj["out"], proj["ba"]
+    return {
+        "hca": pack_hc(lw, "attn_hyper_connection"),
+        "hcm": pack_hc(lw, "mlp_hyper_connection"),
+        "ip": ip,
+        "ip_s": ip_s,
+        "conv_w": lw[a + "conv1d.weight"].squeeze(1).contiguous(),
+        "neg_a": (-torch.exp(lw[a + "A_log"].float())).contiguous(),
+        "dt_bias": lw[a + "dt_bias"].float().contiguous(),
+        "norm_w": lw[a + "norm.weight"].float().contiguous(),
+        "out": out,
+        "out_s": out_s,
+        # b/a rows stay row-major FP8 (the GDN core dots them with the per-token FP8
+        # activation)
+        "ba": ba,
+        "ba_s": ba_s,
+        "router": pack_router(lw),
+        "moe": moe,
+    }
+
+
+def gdn_ptr_row(t, conv_state, ssm_state):
+    """Pointer table row of a GDN layer; conv / ssm state: the base of the layer's
+    [slots, ...] pools."""
+    row = [0] * LY.N_PTR
+    _common_rows(row, t)
+    row[LY.P_IP] = t["ip"].data_ptr()
+    row[LY.P_CONV_W] = t["conv_w"].data_ptr()
+    row[LY.P_NEG_A] = t["neg_a"].data_ptr()
+    row[LY.P_DT_BIAS] = t["dt_bias"].data_ptr()
+    row[LY.P_NORM_W] = t["norm_w"].data_ptr()
+    row[LY.P_OUT] = t["out"].data_ptr()
+    row[LY.P_CONV_STATE] = conv_state.data_ptr()
+    row[LY.P_SSM_STATE] = ssm_state.data_ptr()
+    row[LY.P_BA] = t["ba"].data_ptr()
+    row[LY.P_IP_S] = t["ip_s"].data_ptr()
+    row[LY.P_OUT_S] = t["out_s"].data_ptr()
+    row[LY.P_BA_S] = t["ba_s"].data_ptr()
+    return row
+
+
+def pack_qsa_layer(lw, moe, proj):
+    """A QSA layer's views. proj: SGLang's FP8 params {"qp": qkv_proj, "qp2":
+    indexer.index_qk_proj, "out": o_proj} as (weight, scale)."""
+    a = "self_attn."
+    (qp, qp_s), (qp2, qp2_s), (out, out_s) = proj["qp"], proj["qp2"], proj["out"]
+    return {
+        "hca": pack_hc(lw, "attn_hyper_connection"),
+        "hcm": pack_hc(lw, "mlp_hyper_connection"),
+        "qp": qp,
+        "qp_s": qp_s,
+        "qp2": qp2,
+        "qp2_s": qp2_s,
+        "out_s": out_s,
+        "qnorm": lw[a + "q_norm.weight"].contiguous(),
+        "knorm": lw[a + "k_norm.weight"].contiguous(),
+        "iqnorm": lw[a + "indexer.q_layernorm.weight"].contiguous(),
+        "iknorm": lw[a + "indexer.k_layernorm.weight"].contiguous(),
+        "out": out,
+        "router": pack_router(lw),
+        "moe": moe,
+    }
+
+
+def _common_rows(row, t):
+    """The hyper-connection, router and MoE pointers every layer row carries."""
+    row[LY.P_HCA_NORM] = t["hca"]["norm"].data_ptr()
+    row[LY.P_HCA_DOWN] = t["hca"]["down"].data_ptr()
+    row[LY.P_HCA_UP] = t["hca"]["up"].data_ptr()
+    row[LY.P_HCA_INJ] = t["hca"]["inj"].data_ptr()
+    row[LY.P_HCM_NORM] = t["hcm"]["norm"].data_ptr()
+    row[LY.P_HCM_DOWN] = t["hcm"]["down"].data_ptr()
+    row[LY.P_HCM_UP] = t["hcm"]["up"].data_ptr()
+    row[LY.P_HCM_INJ] = t["hcm"]["inj"].data_ptr()
+    row[LY.P_ROUTER] = t["router"].data_ptr()
+    row[LY.P_GU] = t["moe"]["gu"].data_ptr()
+    row[LY.P_GU_S] = t["moe"]["gu_s"].data_ptr()
+    row[LY.P_DN] = t["moe"]["dn"].data_ptr()
+    row[LY.P_DN_S] = t["moe"]["dn_s"].data_ptr()
+
+
+def qsa_ptr_row(t, k_buf, v_buf, ring, comp):
+    """Pointer table row of a QSA layer (and its KV / index-ring / compressed
+    buffers)."""
+    for b in (k_buf, v_buf):  # addressed with 64-bit pointers (any pool size)
+        assert b.is_contiguous() and b.shape[-2:] == (2, 256)
+    for b in (ring, comp):
+        assert b.is_contiguous() and b.numel() * b.element_size() < 2**32, (
+            "buffer offsets are 32-bit"
+        )
+    row = [0] * LY.N_PTR
+    _common_rows(row, t)
+    row[LY.P_IP] = t["qp"].data_ptr()
+    row[LY.P_OUT] = t["out"].data_ptr()
+    row[LY.P_IP_S] = t["qp_s"].data_ptr()
+    row[LY.P_IP2] = t["qp2"].data_ptr()
+    row[LY.P_IP2_S] = t["qp2_s"].data_ptr()
+    row[LY.P_OUT_S] = t["out_s"].data_ptr()
+    row[LY.P_QNORM] = t["qnorm"].data_ptr()
+    row[LY.P_KNORM] = t["knorm"].data_ptr()
+    row[LY.P_IQNORM] = t["iqnorm"].data_ptr()
+    row[LY.P_IKNORM] = t["iknorm"].data_ptr()
+    row[LY.P_KBUF] = k_buf.data_ptr()
+    row[LY.P_VBUF] = v_buf.data_ptr()
+    row[LY.P_RING] = ring.data_ptr()
+    row[LY.P_COMP] = comp.data_ptr()
+    return row
+
+
+def global_ptr_row(
+    positions,
+    out_cache_loc,
+    req_pool_idx,
+    seq_lens,
+    req_to_token,
+    cos_sin,
+    rope_pos,
+    mamba_map,
+):
+    assert cos_sin.dtype == torch.bfloat16 and req_to_token.dtype == torch.int32
+    row = [0] * LY.N_PTR
+    row[LY.G_MAMBA_MAP] = mamba_map.data_ptr()
+    row[LY.G_POS] = positions.data_ptr()
+    row[LY.G_LOC] = out_cache_loc.data_ptr()
+    row[LY.G_REQ] = req_pool_idx.data_ptr()
+    row[LY.G_SEQ] = seq_lens.data_ptr()
+    row[LY.G_RTT] = req_to_token.data_ptr()
+    row[LY.G_COS] = cos_sin.data_ptr()
+    row[LY.G_ROPEPOS] = rope_pos.data_ptr()
+    return row
+
+
+def pack_ple(lw):
+    """PLE weights of layer 1: packed [key_proj; value_proj] + norms + dilated conv weight."""
+    p = "ple."
+    w = torch.cat(
+        [lw[p + "key_proj.weight"], lw[p + "value_proj.weight"]], dim=0
+    ).contiguous()
+    return {
+        "w": pack_bf16(w),
+        "nk": lw[p + "norm_key.weight"].contiguous(),
+        "nq": lw[p + "norm_query.weight"].contiguous(),
+        "nc": lw[p + "norm_conv.weight"].contiguous(),
+        "cw": lw[p + "conv1d.weight"].squeeze(1).contiguous(),
+    }
+
+
+def add_ple_ptrs(row, t, state):
+    """Add PLE pointers (and the [slots, 10240, 9] short-conv state base) to a layer row."""
+    assert (
+        state.dtype == torch.bfloat16
+        and state.is_contiguous()
+        and state[0].numel() * 2 == LY.PLE_STATE_SLOT_BYTES
+    )
+    row[LY.P_PLE_W] = t["w"].data_ptr()
+    row[LY.P_PLE_NK] = t["nk"].data_ptr()
+    row[LY.P_PLE_NQ] = t["nq"].data_ptr()
+    row[LY.P_PLE_NC] = t["nc"].data_ptr()
+    row[LY.P_PLE_CW] = t["cw"].data_ptr()
+    row[LY.P_PLE_STATE] = state.data_ptr()
+    return row
+
+
+def pack_mtp(lw, moe, proj):
+    """MTP draft head: QSA layer 0 (FP8 projections, MXFP4 routed + shared experts),
+    input fusion, final mixer."""
+    p = "layers.0."
+    a = p + "self_attn."
+    (qp, qp_s), (qp2, qp2_s), (out, out_s) = proj["qp"], proj["qp2"], proj["out"]
+    sub = {k[len(p) :]: v for k, v in lw.items() if k.startswith(p)}
+    layer = {
+        "hca": pack_hc(sub, "attn_hyper_connection"),
+        "hcm": pack_hc(sub, "mlp_hyper_connection"),
+        "qp": qp,
+        "qp_s": qp_s,
+        "qp2": qp2,
+        "qp2_s": qp2_s,
+        "qnorm": lw[a + "q_norm.weight"].contiguous(),
+        "knorm": lw[a + "k_norm.weight"].contiguous(),
+        "iqnorm": lw[a + "indexer.q_layernorm.weight"].contiguous(),
+        "iknorm": lw[a + "indexer.k_layernorm.weight"].contiguous(),
+        "out": out,
+        "out_s": out_s,
+        "router": pack_router(sub),
+        "moe": moe,
+    }
+    return {
+        "layer": layer,
+        "pe": lw["pre_fc_norm_embedding.weight"].contiguous(),
+        "ph": lw["pre_fc_norm_hidden.weight"].contiguous(),
+        "fce": pack_bf16(lw["fc_embedding.weight"].contiguous()),
+        "fch": pack_bf16(lw["fc_hidden.weight"].contiguous()),
+        "final": {
+            "norm": lw["hyper_connection_mixer.hc_norm.weight"].contiguous(),
+            "down": pack_hc_down(
+                lw["hyper_connection_mixer.input_mix_weight_down.weight"]
+            ),
+            "up": pack_bf16(
+                lw["hyper_connection_mixer.input_mix_weight_up.weight"].contiguous()
+            ),
+        },
+    }
+
+
+def mtp_rows(m, k_buf, v_buf, ring, comp, grow):
+    """Pointer rows of a draft launch: [QSA layer row, global row (+ fusion
+    pointers), final-mixer row]."""
+    row = qsa_ptr_row(m["layer"], k_buf, v_buf, ring, comp)
+    grow[LY.G_MTP_PE] = m["pe"].data_ptr()
+    grow[LY.G_MTP_PH] = m["ph"].data_ptr()
+    grow[LY.G_MTP_FCE] = m["fce"].data_ptr()
+    grow[LY.G_MTP_FCH] = m["fch"].data_ptr()
+    frow = [0] * LY.N_PTR
+    frow[LY.P_HCA_NORM] = m["final"]["norm"].data_ptr()
+    frow[LY.P_HCA_DOWN] = m["final"]["down"].data_ptr()
+    frow[LY.P_HCA_UP] = m["final"]["up"].data_ptr()
+    frow[LY.P_HCA_INJ] = m["layer"]["hca"]["inj"].data_ptr()  # combine gate unused
+    return [row, grow, frow]
+
+
+def unshuffle16(w):
+    """aiter shuffle_weight(w, (16, 16)) inverse for 1-byte elements: [N, K] storage
+    -> row-major [N, K] bytes."""
+    w = w.view(torch.uint8)
+    rows, kb = w.shape
+    return (
+        w.reshape(rows // 16, kb // 32, 2, 16, 16)
+        .permute(0, 3, 1, 2, 4)
+        .reshape(rows, kb)
+    )
+
+
+def unshuffle_moe_expert(m, e):
+    """Expert e of the AITER-layout MoE params back to the checkpoint layout, real
+    rows / K only: -> (gate [640, 1280], up [640, 1280], down [2560, 320],
+    gate_s [640, 80], up_s [640, 80], down_s [2560, 20])."""
+    I, IP = LY.MOE_INTER, LY.MOE_INTER_PAD
+
+    def s_un(s):
+        # e8m0_shuffle inverse: [a, d, f, c, e, b] -> [32 a + 16 b + c, 8 d + 4 e + f]
+        rows, g = s.shape
+        return (
+            s.reshape(rows // 32, g // 8, 4, 16, 2, 2)
+            .permute(0, 5, 3, 1, 4, 2)
+            .reshape(rows, g)
+        )
+
+    gu, gus = unshuffle16(m["gu"][e]), s_un(m["gu_s"][e])
+    dn, dns = unshuffle16(m["dn"][e]), s_un(m["dn_s"][e])
+    return (
+        gu[:I],
+        gu[IP : IP + I],
+        dn[:, : I // 2],
+        gus[:I, :],
+        gus[IP : IP + I, :],
+        dns[:, : I // 32],
+    )
