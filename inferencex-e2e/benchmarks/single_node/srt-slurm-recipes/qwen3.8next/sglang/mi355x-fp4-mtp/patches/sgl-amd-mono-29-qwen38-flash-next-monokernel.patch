+                        if const_expr(src[0] == "mb"):
+                            got = poll(
+                                [(src[1], t * (HC_DIM // 2) + row // 2, 1)] + gspecs
+                            )
+                            hw = got[0][0]
+                            gp = got[1:]
+                        else:
+                            hw = h_words(src, t, [row // 2])[0]
+                            gp = poll(gspecs)
+                        gsum = gp[0][0].bitcast(fx.Float32)
+                        for s_ in range_constexpr(1, LY.MIX_KSPLIT):
+                            gsum = gsum + gp[s_][0].bitcast(fx.Float32)
