+                    NC = LY.ATT_CHUNKS
+                    tb = t * LY.ATT_TASKS * LY.PART_STRIDE
+                    if tid < NC:
+                        pb = tb + tid * LY.PART_STRIDE + 24 * 256
+                        ml = poll([(part, pb + h, 1), (part, pb + 24 + h, 1)])
+                        lds_st(xs, OUTS + tid, ml[0][0].bitcast(fx.Float32))
+                        lds_st(xs, OUTS + 64 + tid, ml[1][0].bitcast(fx.Float32))
+                    gpu.barrier()
+                    if tid < 256:
