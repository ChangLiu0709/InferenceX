+                        L = fx.Float32(0.0)
+                        O = fx.Float32(0.0)
+                        got = poll(
+                            [
+                                (part, tb + cc * LY.PART_STRIDE + h * 256 + d, 1)
+                                for cc in range(NC)
+                            ]
+                            + [
