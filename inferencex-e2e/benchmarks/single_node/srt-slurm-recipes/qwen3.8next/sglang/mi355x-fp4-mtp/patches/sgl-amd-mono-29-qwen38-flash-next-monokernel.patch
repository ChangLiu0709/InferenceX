--- /dev/null
+++ b/sgl_amd_mono/qwen38_flash_next/gfx950/device.py
@@ -0,0 +1,58 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Qwen3.8-Flash-Next's device helpers that ``sgl_amd_mono.common`` does not hold:
+the guarded wait of a one-GPU launch."""
+
+import flydsl.compiler as flyc
+import flydsl.expr as fx
+from aiter.ops.flydsl.kernels import buffer_ops as bo
+from flydsl.expr import const_expr, rocdl
+from flydsl.expr.typing import T
+
+from sgl_amd_mono.common import guard
+from sgl_amd_mono.common.ops import ballot, rsrc
+from sgl_amd_mono.common.sync import CHECK_POLLS, _spin
+
+
+def _deadline(epoch):
+    """The guard's deadline in clock ticks (words 1-2 of the epoch buffer), loaded
+    into scalar registers: a wait's check takes no vector register."""
+    w = fx.Vector(
+        bo.buffer_load(rsrc(epoch), 0, vec_width=4, dtype=T.i32, is_scalar=True)
+    )
+    lo, hi = w[guard.GUARD_DEADLINE], w[guard.GUARD_DEADLINE + 1]
+    return (fx.Int64(hi) << 32) | (fx.Int64(lo) & fx.Int64(0xFFFFFFFF))
+
+
+@flyc.jit
+def spin(load_all, pending):
+    """``load_all()`` again while ``pending(value)``; the value.
+
+    The wait of a launch that runs on one GPU (TP 1, no peers): a pending wait
+    re-polls with a single ``s_nop`` between loads and checks its deadline every
+    ``CHECK_POLLS`` polls. Past it, it sets the error word and stops the launch
+    (``guard.Guard.fail``): with no peers there is no failure elsewhere to watch,
+    and a failed wait on this GPU has already stopped it. The fault injection's
+    stall runs ``common.sync._spin``."""
+    g = guard.current()
+    assert g is None or g.peers is None, "a wait with peers takes common.sync._spin"
+    if const_expr(g is None or g.fault_site is not None):
+        return _spin(load_all, pending)
+    site = g.next_site()
+    epoch, fail = g.epoch, g.fail
+    v = load_all()
+    t0 = fx.Int64(0)
+    polls = fx.Int32(0)
+    late = fx.Int32(0)
+    # a wave-uniform loop (until no lane is pending), so its poll count and clock
+    # stay in scalar registers; a satisfied lane reloads words that no longer change
+    while (ballot(pending(v)) != 0) & (late == 0):
+        rocdl.s_nop(0)
+        v = load_all()
+        polls = polls + 1
+        if (polls & (CHECK_POLLS - 1)) == 0:
+            now = guard.clock()
+            t0 = (polls == CHECK_POLLS).select(now, t0)
+            late = ((now - t0) > _deadline(epoch)).select(fx.Int32(1), fx.Int32(0))
+    if late != 0:
+        fail(site)
+    return v
diff --git a/sgl_amd_mono/qwen38_flash_next/gfx950/kernel.py b/sgl_amd_mono/qwen38_flash_next/gfx950/kernel.py
new file mode 100644
index 0000000..64d5111
--- /dev/null
+++ b/sgl_amd_mono/qwen38_flash_next/gfx950/kernel.py
@@ -0,0 +1,4625 @@
+# SPDX-License-Identifier: Apache-2.0
+# ruff: noqa: B008, B023, E501, SIM102
+"""Qwen3.8-Flash-Next (SGLang's Qwen4-Exp) monokernel: the decoder stack of a
+speculative verify (and the MTP draft) of R requests x L tokens.
+
+One persistent launch of 256 CTAs x 512 threads runs whole decoder layers (3 GDN +
+1 QSA per launch, 13 launches a verify)::
+
+    [prelude: embedding + n-gram history]  [PLE of layer 1]
+    per layer: mix a -> GDN (in_proj -> conv + gated delta rule) | QSA (proj -> prep
+      -> scores -> select -> merge select -> attention -> merge) -> out_proj
+      -> mix m -> router -> MXFP4 gate / up -> down (+ the shared expert)
+    [final mix: the model-level hyper-connection mixer]
+
+R requests x L tokens = S rows (compile-time, S <= 32; row t = request t // L,
+draft step t % L):
+
+* FP8 attention / GDN projections (W8A8): ``mfma_scale_f32_16x16x128_f8f6f4`` on
+  SGLang's AITER-shuffled FP8 weights (per-channel scales) and per-token dynamic FP8
+  activations (AITER's quantization), with the S rows as MFMA N-columns in
+  NCT = ceil(S / 16) column tiles that share the weight registers;
+* MXFP4 experts read in place from SGLang's FusedMoE params (AITER layout, the
+  shared expert fused at index 512);
+* bf16 skinny GEMMs (``mfma_f32_16x16x32_bf16``) for the hyper-connection mixers,
+  router, PLE and MTP input fusion;
+* per-request state: positions / RoPE, KV locations (req_to_token row), mamba slot,
+  verify-scratch row (row r of intermediate_ssm / intermediate_conv_window / PLE
+  intermediate state / n-gram context);
+* GDN: the gated delta rule runs each request's L tokens in order on its own
+  register-resident state and writes the state / conv window after every token
+  into scratch row r;
+* QSA: per-row causal sparse attention inside its request (row t sees its request's
+  positions <= pos_t, its own top-512 blocks); index-key ring / compression per
+  request; two-level exact top-512 per row;
+* MoE: per-row top-10, the union of the routed experts of all rows (+ shared) is
+  computed once; only the routed (row, expert) pairs are handed to the down
+  projection.
+
+Every stage is a list of tasks; a task runs on CTA (base + t) % 256 and every CTA
+walks the stages in order. There is no grid-wide barrier: dependencies only point
+to earlier stages and all CTAs are co-resident, so every wait makes progress.
+Stages hand values over through tagged-pair mailboxes in a global scratch buffer,
+tagged ``epoch * LAUNCH_SLOTS + launch + 1``; each wait runs under the guard
+(``common/guard.py``): past its deadline it stops the launch (TP 1: a failure stays
+on this GPU), so no step runs on with words that never arrived.
+"""
+
+import functools
+
+import flydsl.compiler as flyc
+import flydsl.expr as fx
+from aiter.ops.flydsl.kernels import buffer_ops as bo
+from flydsl._mlir.dialects import llvm
+from flydsl.expr import const_expr, gpu, range_constexpr, rocdl
+from flydsl.expr.typing import Int32, Int64, T, as_ir_value
+
+from sgl_amd_mono.common import guard
+from sgl_amd_mono.common.epoch import kernel_symbol
+from sgl_amd_mono.common.ops import (
+    CM_DEV,
+    bf2_f32,
+    bf16_pair,
+)
+from sgl_amd_mono.common.ops import bf16_round as bf_round
+from sgl_amd_mono.common.ops import (
+    butterfly,
+)
+from sgl_amd_mono.common.ops import fp8_roundtrip as _fp8_roundtrip
+from sgl_amd_mono.common.ops import (
+    fresh,
+    global_load,
+)
+from sgl_amd_mono.common.ops import hw_exp as _exp
+from sgl_amd_mono.common.ops import hw_rcp as _rcp
+from sgl_amd_mono.common.ops import hw_rsq as _rsq
+from sgl_amd_mono.common.ops import (
+    load_ptr64,
+)
+from sgl_amd_mono.common.ops import mxfp4_to_bf16x8 as _mxfp4_to_bf16x8
+from sgl_amd_mono.common.ops import rsrc as _rsrc
+from sgl_amd_mono.common.ops import uniform as _uniform
+from sgl_amd_mono.common.ops import wave_umax as _wave_umax
+from sgl_amd_mono.common.ops import xred as _xred
+from sgl_amd_mono.common.ops import xshfl as _xshfl
+from sgl_amd_mono.common.plan import BLOCKS, THREADS, WAVES, kernel_sources, key_tuple
+
+from . import layout as LY
+from .config import (
+    EPS,
+    GDN_DK,
+    GDN_HV,
+    GDN_KEY_DIM,
+    GDN_VAL_DIM,
+    HC,
+    HC_DIM,
+    HC_LOWRANK,
+    HIDDEN,
+    MAX_R,
+    MAX_T,
+    MOE_INTER,
+    N_EXPERTS,
+    TOPK,
+    MonoBuild,
+)
+from .device import spin
+from .layout import scratch_layout
+
+SOURCES = kernel_sources(__name__)
+
+POLL_MAX = 24
+NEG_INF = -3.0e38
+LDS_WORDS = 40448  # 158 KB arena (gfx950: 160 KB per CU)
+RED_OFF = 0  # MFMA accumulator exchange: [tile][column tile][wave][lane][4] f32
+
+
+def act_stride(n):
+    """LDS row stride (words) of a [T][n] bf16 activation: n/2 + 4 keeps (stride / 4) odd, so the 16 MFMA
+    B-operand rows (one per token) of a ds_read_b128 land on distinct bank quads."""
+    s = n // 2 + 4
+    assert (s // 4) % 2 == 1, n
+    return s
+
+
+def act_stride8(n):
+    """LDS row stride (words) of a [S][n] FP8 activation: n/4 + 4 keeps (stride / 4) odd (conflict-free B reads)."""
+    s = n // 4 + 4
+    assert (s // 4) % 2 == 1, n
+    return s
+
+
+def _ordered_i32(v):
+    """Side-effecting copy with a memory clobber: memory operations are not reordered across it (bounds how far
+    the scheduler hoists independent weight loads)."""
+    return fx.Int32(
+        llvm.InlineAsmOp(
+            T.i32,
+            [as_ir_value(fx.Int32(v))],
+            "v_mov_b32 $0, $1",
+            "=v,v,~{memory}",
+            has_side_effects=True,
+        ).result
+    )
+
+
+def _pin(vals, mem=False):
+    """Fake use of f32 values by a side-effecting asm: the instructions producing them (MFMAs) stay before the
+    next side-effecting operation (barrier) instead of being sunk past it with their operands live. mem: also a
+    compiler memory barrier (later LDS / global loads are not hoisted above it)."""
+    for i in range(0, len(vals), 8):
+        part = vals[i : i + 8]
+        llvm.InlineAsmOp(
+            None,
+            [as_ir_value(fx.Float32(v)) for v in part],
+            "",
+            ",".join(["v"] * len(part)) + (",~{memory}" if mem else ""),
+            has_side_effects=True,
+        )
+
+
+def _log2(v):
+    return fx.Float32(
+        llvm.call_intrinsic(
+            T.f32, "llvm.amdgcn.log.f32", [fx.Float32(v).ir_value()], [], []
+        )
+    )
+
+
+# Batcher's odd-even merge sort of 8 elements: compare-exchange pairs (a, b), a receives the larger
+_MERGE_SORT_8 = (
+    (0, 1), (2, 3), (4, 5), (6, 7), (0, 2), (1, 3), (4, 6), (5, 7), (1, 2), (5, 6),
+    (0, 4), (1, 5), (2, 6), (3, 7), (2, 4), (3, 5), (1, 2), (3, 4), (5, 6),
+)  # fmt: skip
+
+
+@functools.cache
+def _bitonic_pairs(n):
+    """Compare-exchange pairs (a, b) of a descending bitonic sort of n = 2^k elements: a receives the larger."""
+    out = []
+    k = 2
+    while k <= n:
+        j = k // 2
+        while j >= 1:
+            for i in range(n):
+                partner = i ^ j
+                if partner > i:
+                    out.append((i, partner) if (i & k) == 0 else (partner, i))
+            j //= 2
+        k *= 2
+    return tuple(out)
+
+
+def build_qwen38_flash_next_kernel(key: MonoBuild):
+    """Return the ``@flyc.jit`` launcher of one launch (``MonoBuild``): the layers
+    of ``key.plan`` for R = ``key.nreq`` requests x L = ``key.ntok`` tokens. The
+    pointer table has one row per layer plus a global row (and the final mixer's
+    row after it in a ``final_mix`` launch)."""
+    keyed = key_tuple(key, SOURCES)
+    plan, nreq, ntok = key.layers, key.nreq, key.ntok
+    rtt_stride, pos_stride, map_i64 = key.rtt_stride, key.pos_stride, key.map_i64
+    seq_p0, ring = key.seq_p0, key.ring
+    ple_first, final_mix, prelude = key.ple_first, key.final_mix, key.prelude
+    eos_token_id, first_src, ssm_bf16 = key.eos_token_id, key.first_src, key.ssm_bf16
+    issm_row, ple_ist_row, ictx_row = key.issm_row, key.ple_ist_row, key.ictx_row
+    iconv_strides = (key.iconv.step, key.iconv.channel, key.iconv.window, key.iconv.row)
+    fault_site, fault_after = key.fault_site, key.fault_after
+    R, L = nreq, ntok
+    NT = R * L
+    assert 1 <= R <= MAX_R and 1 <= NT <= MAX_T
+    n_layers = len(plan)
+    regions, _ = scratch_layout(n_layers + 2, NT, R)
+    G = BLOCKS
+    NCT = (NT + 15) // 16  # MFMA column tiles of the S rows
+    KPH = LY.kphases(NT)  # K phases of the K=2560 activation GEMMs
+    KH = HIDDEN // KPH  # K elements staged per phase
+    S_ACT = act_stride(KH)  # [S][2560 / KPH] activation rows
+    S_A8 = act_stride8(HIDDEN)  # [S][2560] FP8 rows (fit the LDS for every S <= 32)
+    # QB (8 <= S <= 16): activations staged in LDS as bf16 (raw mailbox copy, row amax reduced on the fly or from the
+    # producers' partials) and quantized to FP8 per token while the MFMA B operands are built (no re-poll, no FP8
+    # staging pass). S < 8: FP8 staging (one poll round); S = 32: FP8 staging (two-pass, bf16 rows do not fit the LDS)
+    QB = 8 <= NT <= 16
+    # OP_KS: out_proj K parts staged one after the other (og [S][6144 / OP_KS]; S = 32:
+    # three parts keep the weights in registers); OG_BATCH: og polls per round
+    if QB:
+        OP_KS = 1 if NT <= 8 else 2
+        S_OG = act_stride(GDN_VAL_DIM // OP_KS)
+        OG_BATCH = 12  # next to the out_proj weight vectors, no spills
+    else:
+        OP_KS = 1 if NT <= 16 else 3
+        S_OG = act_stride8(GDN_VAL_DIM // OP_KS)
+        OG_BATCH = 24 if NT <= 4 else (12 if NT <= 16 else 8)
+    # in_proj / QSA proj: activation polls per round, and weight tiles in flight
+    # (issued before the activation is staged)
+    A8_BATCH = 12 if QB or NT > 16 else POLL_MAX
+    G8_PD = 2 if QB else 1
+    S_HNS = act_stride(1024)  # [S][1024] Hn K-slice of a mix
+    S_TACT = act_stride(HC_LOWRANK)  # [S][320]
+    SG = LY.dn_sg(NT)  # expert slots per down K-group
+    S_MID = act_stride(SG * MOE_INTER)  # [S][SG * 640]
+    NS_MAX = LY.max_slots(NT)
+    NPAIR = LY.MOE_PAIR  # (row, expert) pairs per row
+    CN = LY.cnew_slots(L)
+    IC_STEP, IC_DIM, IC_WIN, IC_ROW = iconv_strides
+    CSPLIT = LY.core_split(NT)
+    C_ROWS, C_TASKS, C_RPT, C_KPT, C_RED = LY.core_geom(CSPLIT)
+    RED_SLOT = WAVES * 64 * 4  # words of one (tile, column tile) accumulator slot
+    KPG = LY.gu_kphases(NT)  # K phases (CTA halves) of the MoE gate/up
+    S_GU = act_stride(HIDDEN // KPG)  # [S][2560 / KPG] gate/up activation rows
+    # work area above the accumulator slots of tile 0 (NCT = 1: 4 tiles)
+    W0 = (4 if NCT == 1 else NCT) * RED_SLOT
+
+    # ---- LDS map (f32 words); stage work areas alias each other above W0
+    # tail (every CTA, whole launch): batch tokens, rope positions, per-request tables, work prefix sums
+    EMB_TOK = LDS_WORDS - 32  # [S] token ids (prelude / MTP launches)
+    POS3 = EMB_TOK - 3 * 32  # [3][S] rope positions of the batch rows
+    RQ_REQ = POS3 - 8  # [R] req pool index
+    RQ_MS = RQ_REQ - 8  # [R] mamba slot
+    RQ_P0 = RQ_MS - 8  # [R] position of the request's first verify token
+    SC_PFX = RQ_P0 - 16  # [R + 1] prefix sums of the index-score tiles of the requests
+    SL_PFX = SC_PFX - 48  # [S + 1] prefix sums of the rows' top-512 selection tasks
+    ASC = SL_PFX - 32  # [S] per-token FP8 activation scale of the current GEMM
+    AINV = ASC - 32  # [S] its reciprocal (448 / amax)
+    TAIL_OFF = AINV
+    # persistent across the MoE stages of a layer: route tables
+    PERS_WORDS = NS_MAX + 512 + 2 * NT * 16 + NT + 16 + 2 * SG * NT
+    PERS_OFF = TAIL_OFF - PERS_WORDS
+    SLOT_E = PERS_OFF  # [NS] expert id of slot
+    SLOT_OF = SLOT_E + NS_MAX  # [512] slot of expert (valid where flagged)
+    FLAG = SLOT_OF  # aliases SLOT_OF before it is written: [512] flags
+    TOPI = SLOT_OF + 512  # [S][16] top-10 ids (int)
+    TOPW = TOPI + NT * 16  # [S][16] weights
+    SHG = TOPW + NT * 16  # [S] shared gate
+    NSV = SHG + NT  # [1] number of slots, [8] wave totals
+    WTOT = NSV + 4
+    RNK = NSV + 16  # [SG][S] down: pair rank of (group slot, row) (-1: not routed)
+    SWG = RNK + SG * NT  # [SG][S] down: route weight of (group slot, row)
+    assert SWG + SG * NT <= TAIL_OFF
+    # mix
+    MIX_RSTD = W0  # [S][4]
+    MIX_HNS = MIX_RSTD + 4 * NT  # [S][S_HNS]
+    MIX_TACT = MIX_HNS + NT * S_HNS  # [S][S_TACT]
+    MIX_OUTS = MIX_TACT + NT * S_TACT  # [S][64]
+    assert MIX_OUTS + 128 * NT + THREADS <= TAIL_OFF
+    # GEMV activation
+    OUTS = W0  # small per-stage outputs ([S][16] words, merge scratch) after the GEMM (ACT dead)
+    ACT = W0 + 256
+    assert ACT + NT * S_OG <= TAIL_OFF, "out_proj activation does not fit LDS"
+    assert ACT + NT * S_ACT <= TAIL_OFF
+    # MoE (wave-level tasks, no accumulator exchange): small outputs at 0, then the gate/up activation (live with
+    # the route tables) / the staged mid of a down group
+    MOE_OUTS = 0  # down: routed pair list [SG S], then the group sums [S][16]
+    GU_ACT = 512
+    assert GU_ACT + NT * S_GU <= PERS_OFF, (
+        "gate/up activation + route tables do not fit LDS"
+    )
+    # GDN core
+    C_Q = W0  # [S][288] f32 conv outputs (q 128, k 128, v 32)
+    C_Z = C_Q + NT * 288  # [S][32]
+    C_O = C_Z + NT * 32  # [S][32]
+    C_OG = C_O + NT * 32  # [S][16] words (bf16 og)
+    C_SC = C_OG + NT * 16  # [S][4] beta, decay, k.q
+    C_BA = C_SC + 4 * NT  # [2][2560] bf16 b/a projection rows of the head
+    assert C_BA + HIDDEN <= TAIL_OFF
+    # MoE down: staged mid of a slot group
+    MID = 512
+    assert MID + NT * S_MID <= PERS_OFF and 16 * NT <= MID
+    # QSA attention (per task) / select
+    ATT_OFF = W0
+    ATT_KS = 132
+    ATT_VS = 72
+    ATT_KV_WORDS = max(64 * ATT_KS, 256 * ATT_VS // 2)
+    # per kv head: K [64][ATT_KS] words, then V^T [256][ATT_VS] bf16
+    ATT_Q_OFF = ATT_OFF + 2 * ATT_KV_WORDS
+    ATT_S_OFF = ATT_Q_OFF + 2 * 16 * ATT_KS  # Q [2][16][264] bf16 (rows 12..15 zero)
+    ATT_P_OFF = ATT_S_OFF + 2 * 16 * 64  # S [2][16][64] f32
+    # P [2][16][72] bf16; then m[24], l[24], token flags [64]
+    ATT_M_OFF = ATT_P_OFF + 2 * 16 * ATT_VS // 2
+    assert ATT_M_OFF + 128 <= TAIL_OFF
+    KEYS_OFF = W0
+    QI_OFF = W0 + 64  # scores: [4 S][QS] words of index q rows
+    PREP_OFF = W0  # prep scratch
+    PREP_KEYS = W0 + 1024  # index-key ring of a request's tokens: [L][128] f32
+    assert QI_OFF + 4 * NT * 68 <= TAIL_OFF and PREP_KEYS + L * 128 <= TAIL_OFF
+
+    # MTP input fusion (first_src "mtp"): B rows = S normalized embedding rows + 4 S (row, branch) hidden rows,
+    # staged in MF_KP K phases; E / H column tiles reduced through red slots after the last phase (B dead)
+    MF_ROWS = 5 * NT
+    MF_KP = 1
+    while MF_ROWS * act_stride(HIDDEN // MF_KP) > 27000:
+        MF_KP *= 2
+    MF_KC = HIDDEN // MF_KP
+    S_MF = act_stride(MF_KC)
+    MF_B = 256
+    MF_RS = MF_B + MF_ROWS * S_MF  # [2][S] rstd of the embedding / hidden rows
+    NCTE = (NT + 15) // 16
+    NCTH = (4 * NT + 15) // 16
+    assert MF_RS + 2 * NT <= TAIL_OFF and (NCTE + NCTH) * RED_SLOT <= TAIL_OFF
+
+    @fx.struct
+    class Smem:
+        work: fx.Array[fx.Float32, LDS_WORDS, 16]
+
+    kernel_name = kernel_symbol(
+        "qwen38_flash_next_layers",
+        s=NT,
+        r=R,
