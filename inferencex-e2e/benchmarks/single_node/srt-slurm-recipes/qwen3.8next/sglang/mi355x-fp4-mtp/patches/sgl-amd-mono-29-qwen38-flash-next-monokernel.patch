+            # ---- PLE (per-layer n-gram embedding, layer 1)
+            def stage_ple_proj(layer):
+                """[key; value] = [W_key; W_value] @ emb[t]  (800 row groups, <= 4 per CTA), all rows."""
+                emb = ptr(GI, LY.G_PLE_EMB)
